#: app.py:338
#, python-format
msgid ""
"Hallo,\n"
"\n"
"Sie haben eine Anfrage zum Zurücksetzen Ihres Passworts für FlowLine "
"gestellt.\n"
"Klicken Sie auf den folgenden Link, um ein neues Passwort zu vergeben:\n"
"\n"
"%(url)s\n"
"\n"
"Dieser Link ist 1 Stunde lang gültig.\n"
"Wenn Sie diese Anfrage nicht gestellt haben, können Sie diese E-Mail "
"einfach ignorieren.\n"
"\n"
"Viele Grüße\n"
"Ihr FlowLine Team"
msgstr ""
"Bonjour,\n"
"\n"
"Vous avez demandé la réinitialisation de votre mot de passe pour "
"FlowLine.\n"
"Cliquez sur le lien suivant pour définir un nouveau mot de passe :\n"
"\n"
"%(url)s\n"
"\n"
"Ce lien est valide pendant 1 heure.\n"
"Si vous n'avez pas fait cette demande, vous pouvez simplement ignorer cet"
" e-mail.\n"
"\n"
"Cordialement,\n"
"L'équipe FlowLine"

#: app.py:358
msgid "Ein Link zum Zurücksetzen des Passworts wurde an Ihre E-Mail gesendet."
msgstr ""
"Un lien de réinitialisation du mot de passe a été envoyé à votre adresse "
"e-mail."

#: app.py:369
msgid "❌ Fehler beim Senden der E-Mail. Bitte versuchen Sie es später erneut."
msgstr "❌ Erreur lors de l'envoi de l'e-mail. Veuillez réessayer plus tard."

#: app.py:376
